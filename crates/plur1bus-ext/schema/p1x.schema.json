{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plur1bus.app/schema/p1x/1/p1x.schema.json",
  "title": "PLUR1BUS extension package manifest (p1x.json)",
  "x-stability": "experimental",
  "type": "object",
  "$defs": {
    "range": {
      "type": "string",
      "pattern": "^(?:>=|<=|>|<|=|\\^|~)?[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z.-]+)?(?: (?:>=|<=|>|<|=|\\^|~)?[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z.-]+)?)*$",
      "maxLength": 200
    },
    "langMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
      }
    }
  },
  "properties": {
    "$schema": {
      "const": "https://plur1bus.app/schema/p1x/1/p1x.schema.json"
    },
    "format": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}(\\.[a-z0-9-]{1,32})*/[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 160
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 62
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 64
    },
    "kind": {
      "enum": [
        "skill",
        "module",
        "channel",
        "mcp-server",
        "bundle"
      ]
    },
    "title": {
      "$ref": "#/$defs/langMap",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "summary": {
      "$ref": "#/$defs/langMap",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 280
      }
    },
    "publisher": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}(\\.[a-z0-9-]{1,32})*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^ ]+$",
          "maxLength": 2048
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "licence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://[^ ]+$",
      "maxLength": 2048
    },
    "repository": {
      "type": "string",
      "pattern": "^https://[^ ]+$",
      "maxLength": 2048
    },
    "compat": {
      "type": "object",
      "properties": {
        "harness": {
          "$ref": "#/$defs/range"
        },
        "moduleApi": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rpc": {
          "$ref": "#/$defs/range"
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "linux-x64",
              "linux-arm64",
              "darwin-arm64",
              "darwin-x64",
              "win32-x64",
              "win32-arm64"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "container": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "harness"
      ]
    },
    "requires": {
      "type": "object",
      "properties": {
        "runtime": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "node"
                },
                "range": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "additionalProperties": false,
              "required": [
                "type",
                "range"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "python"
                },
                "range": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "via": {
                  "const": "uv"
                },
                "lock": {
                  "type": "string",
                  "pattern": "^payload/.+"
                }
              },
              "additionalProperties": false,
              "required": [
                "type",
                "range"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "binary"
                }
              },
              "additionalProperties": false,
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "none"
                }
              },
              "additionalProperties": false,
              "required": [
                "type"
              ]
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "runtime"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}(\\.[a-z0-9-]{1,32})*/[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "range": {
            "$ref": "#/$defs/range"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "range"
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "filesystem",
        "processes",
        "harness"
      ],
      "properties": {
        "network": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "allowlist",
                "any"
              ]
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "if": {
            "properties": {
              "mode": {
                "const": "allowlist"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "hosts"
            ]
          }
        },
        "filesystem": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "enum": [
                  "agent-workspace",
                  "extension-data",
                  "home",
                  "path"
                ]
              },
              "access": {
                "enum": [
                  "read",
                  "read-write"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "additionalProperties": false,
            "required": [
              "scope",
              "access"
            ],
            "if": {
              "properties": {
                "scope": {
                  "const": "path"
                }
              },
              "required": [
                "scope"
              ]
            },
            "then": {
              "required": [
                "path"
              ]
            }
          }
        },
        "processes": {
          "type": "object",
          "properties": {
            "spawn": {
              "type": "boolean"
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "spawn"
          ]
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "label": {
                "$ref": "#/$defs/langMap",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "required": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "slot",
              "label",
              "required"
            ]
          }
        },
        "hostBridge": {
          "type": "array",
          "items": {
            "enum": [
              "computer-use",
              "notifications",
              "file-pick",
              "keychain"
            ]
          },
          "uniqueItems": true
        },
        "harness": {
          "type": "object",
          "properties": {
            "authority": {
              "enum": [
                "none",
                "scoped",
                "full"
              ]
            },
            "rpc": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "authority"
          ],
          "if": {
            "properties": {
              "authority": {
                "const": "scoped"
              }
            },
            "required": [
              "authority"
            ]
          },
          "then": {
            "required": [
              "rpc"
            ]
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "effect": {
                "enum": [
                  "read",
                  "write",
                  "destructive"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "effect"
            ]
          }
        },
        "mcpApps": {
          "type": "boolean"
        }
      }
    },
    "remote": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://[^ ]+$",
              "maxLength": 2048
            },
            "auth": {
              "enum": [
                "oauth",
                "header",
                "none"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "url",
            "auth"
          ]
        }
      ]
    },
    "members": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "maxLength": 62
              },
              "path": {
                "type": "string",
                "pattern": "^payload/members/.+\\.p1x$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "optional": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "sha256",
              "optional"
            ]
          }
        }
      ]
    },
    "upstream": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "mcpRegistry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "skill": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "defaultEnabled": {
      "type": "boolean"
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^payload/.+"
      },
      "uniqueItems": true
    },
    "files": {
      "type": "object",
      "patternProperties": {
        "^payload/.+": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "exec": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "sha256",
            "size"
          ]
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "$ref": "#/$defs/langMap",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "format",
    "id",
    "name",
    "version",
    "kind",
    "title",
    "summary",
    "publisher",
    "licence",
    "compat",
    "requires",
    "capabilities",
    "scripts",
    "files"
  ],
  "additionalProperties": false
}
