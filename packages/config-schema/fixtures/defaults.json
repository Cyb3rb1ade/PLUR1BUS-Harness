{
  "$schema": "https://plur1bus.dev/schema/config/1/config.schema.json",
  "schemaVersion": 1,
  "core": {
    "logLevel": "info",
    "recall": {
      "softBudgetMs": 400,
      "hardBudgetMs": 600,
      "capChars": 17000
    },
    "capture": {
      "waitMs": 60000
    },
    "shutdownBudgetMs": 30000
  },
  "supervisor": {
    "graceMs": 60000,
    "healthIntervalMs": 5000
  },
  "metrics": {
    "enabled": false,
    "port": 9464
  },
  "logs": {
    "maxBytes": 20971520,
    "keep": 5
  },
  "agents": {},
  "extensions": {
    "allowUnsigned": true,
    "trashDays": 14,
    "limits": {
      "packageBytes": 268435456,
      "skillBytes": 16777216
    }
  },
  "embedding": {
    "useClass": "general",
    "acceptedNcLicence": false
  },
  "engine": {},
  "providers": {},
  "oauth": {},
  "decision": {},
  "modelRoles": {},
  "modelProfiles": {},
  "models": {
    "scan": {
      "enabled": true,
      "intervalHours": 24
    }
  },
  "secrets": {
    "fileFallback": {
      "enabled": false
    }
  },
  "egress": {
    "allowHosts": [],
    "allowPorts": [
      443
    ],
    "allowLoopback": false
  },
  "channels": {
    "discord": {
      "enabled": false,
      "tokenSecret": "channels.discord.token",
      "intents": [
        "GUILDS",
        "GUILD_MESSAGES",
        "DIRECT_MESSAGES",
        "MESSAGE_CONTENT"
      ],
      "allowlist": [],
      "dmAllowlist": [],
      "replyPolicy": "mention",
      "maxMediaBytes": 10485760,
      "locale": "en"
    },
    "slack": {
      "enabled": false,
      "botTokenSecret": "channels.slack.bot-token",
      "appTokenSecret": "channels.slack.app-token",
      "allowlist": [],
      "dmAllowlist": [],
      "replyPolicy": "mention",
      "maxMediaBytes": 10485760,
      "locale": "en"
    },
    "matrix": {
      "enabled": false,
      "accessTokenSecret": "channels.matrix.access-token",
      "autoJoin": "allowlist",
      "allowlist": [],
      "dmAllowlist": [],
      "replyPolicy": "mention",
      "maxMediaBytes": 10485760,
      "locale": "en"
    },
    "signal": {
      "enabled": false,
      "endpoint": {},
      "allowRemoteEndpoint": false,
      "allowlist": [],
      "dmAllowlist": [],
      "replyPolicy": "mention",
      "maxMediaBytes": 10485760,
      "locale": "en"
    },
    "email": {
      "enabled": false,
      "imap": {
        "port": 993,
        "security": "tls",
        "passwordSecret": "channels.email.imap-password",
        "folder": "INBOX",
        "idle": true,
        "pollIntervalSec": 60
      },
      "smtp": {
        "port": 465,
        "security": "tls",
        "passwordSecret": "channels.email.smtp-password"
      },
      "dmAllowlist": [],
      "maxAttachmentBytes": 10485760,
      "requireAuthPass": false,
      "locale": "en"
    }
  },
  "modules": {}
}
