{
  "$schema": "https://plur1bus.dev/schema/config/1/config.schema.json",
  "schemaVersion": 1,
  "tools": {
    "hostctl": {
      "enabled": true,
      "shell": {
        "allowed": false,
        "default": "bash"
      },
      "exec": {
        "timeoutMs": 30000
      },
      "output": {
        "maxBytes": 65536
      },
      "env": {
        "allow": [
          "PATH",
          "LANG",
          "LC_ALL",
          "TZ",
          "TERM",
          "SystemRoot",
          "PATHEXT",
          "TEMP",
          "TMP"
        ]
      },
      "denyPatterns": [],
      "search": {
        "maxResults": 100
      }
    }
  },
  "core": {
    "logLevel": "info",
    "recall": {
      "softBudgetMs": 400,
      "hardBudgetMs": 600,
      "capChars": 17000
    },
    "capture": {
      "waitMs": 60000
    },
    "shutdownBudgetMs": 30000
  },
  "supervisor": {
    "graceMs": 60000,
    "healthIntervalMs": 5000
  },
  "metrics": {
    "enabled": false,
    "port": 9464
  },
  "logs": {
    "maxBytes": 20971520,
    "keep": 5
  },
  "agents": {},
  "extensions": {
    "allowUnsigned": true,
    "trashDays": 14,
    "limits": {
      "packageBytes": 268435456,
      "skillBytes": 16777216
    }
  },
  "embedding": {
    "useClass": "general",
    "acceptedNcLicence": false
  },
  "engine": {},
  "providers": {},
  "auth": {
    "openai": {
      "loopbackTimeoutMs": 600000,
      "httpTimeoutMs": 30000,
      "refreshSkewSeconds": 120,
      "liveHandleTtlSeconds": 60,
      "voiceDailySeconds": 3600,
      "voiceCapacity": 1,
      "clientRegistration": "dynamic_on_authorize",
      "storeBackend": "auto",
      "federated": {
        "args": [],
        "environment": {}
      }
    }
  },
  "oauth": {},
  "decision": {},
  "modelRoles": {},
  "modelProfiles": {},
  "models": {
    "scan": {
      "enabled": true,
      "intervalHours": 24
    }
  },
  "secrets": {
    "fileFallback": {
      "enabled": false
    }
  },
  "egress": {
    "allowHosts": [],
    "allowPorts": [
      443
    ],
    "allowLoopback": false
  },
  "channels": {
    "discord": {
      "enabled": false,
      "tokenSecret": "channels.discord.token",
      "intents": [
        "GUILDS",
        "GUILD_MESSAGES",
        "DIRECT_MESSAGES",
        "MESSAGE_CONTENT"
      ],
      "allowlist": [],
      "dmAllowlist": [],
      "replyPolicy": "mention",
      "maxMediaBytes": 10485760,
      "locale": "en"
    },
    "slack": {
      "enabled": false,
      "botTokenSecret": "channels.slack.bot-token",
      "appTokenSecret": "channels.slack.app-token",
      "allowlist": [],
      "dmAllowlist": [],
      "replyPolicy": "mention",
      "maxMediaBytes": 10485760,
      "locale": "en"
    },
    "matrix": {
      "enabled": false,
      "accessTokenSecret": "channels.matrix.access-token",
      "autoJoin": "allowlist",
      "allowlist": [],
      "dmAllowlist": [],
      "replyPolicy": "mention",
      "maxMediaBytes": 10485760,
      "locale": "en"
    },
    "signal": {
      "enabled": false,
      "endpoint": {},
      "allowRemoteEndpoint": false,
      "allowlist": [],
      "dmAllowlist": [],
      "replyPolicy": "mention",
      "maxMediaBytes": 10485760,
      "locale": "en"
    },
    "email": {
      "enabled": false,
      "imap": {
        "port": 993,
        "security": "tls",
        "passwordSecret": "channels.email.imap-password",
        "folder": "INBOX",
        "idle": true,
        "pollIntervalSec": 60
      },
      "smtp": {
        "port": 465,
        "security": "tls",
        "passwordSecret": "channels.email.smtp-password"
      },
      "dmAllowlist": [],
      "maxAttachmentBytes": 10485760,
      "requireAuthPass": false,
      "locale": "en"
    }
  },
  "voice": {
    "providers": {
      "elevenlabs": {
        "enabled": false,
        "region": "default",
        "zeroRetention": false
      },
      "xai": {
        "enabled": false
      },
      "gemini": {
        "enabled": false
      },
      "polly": {
        "enabled": false,
        "credentials": {}
      }
    },
    "local": {
      "profile": "fast",
      "perAgent": {},
      "acceptNcLicence": false
    },
    "localRealtime": {
      "enabled": false,
      "endpointingMs": 400,
      "speculativeTurnStart": false,
      "ackSound": false,
      "sentenceChunking": {
        "maxWords": 24
      },
      "features": {
        "autoRecall": {
          "mode": "on",
          "maxMs": 30
        },
        "reranker": {
          "mode": "off"
        },
        "recallMultiIdentity": {
          "mode": "off"
        },
        "promptEnrichment": {
          "mode": "on",
          "maxMs": 10
        },
        "decisionService": {
          "mode": "off"
        },
        "postTurnRefine": {
          "mode": "deferred"
        },
        "memoryWrite": {
          "mode": "deferred"
        },
        "compaction": {
          "mode": "deferred"
        }
      },
      "toolSchemas": "reduced",
      "auditDetail": "minimal",
      "perAgent": {}
    }
  },
  "modules": {},
  "media": {
    "video": {
      "maxBytes": 536870912,
      "embedMetadata": false,
      "adapters": {}
    },
    "adapters": {
      "openai": {
        "model": "gpt-image-2.5-sunburst",
        "timeoutMs": 120000,
        "maxConcurrent": 2
      },
      "google": {
        "model": "gemini-nano-banana-2.1",
        "timeoutMs": 120000,
        "maxConcurrent": 2
      },
      "xai": {
        "model": "grok-imagine-image-2.0",
        "timeoutMs": 120000,
        "maxConcurrent": 2
      },
      "openrouter": {
        "model": "google/gemini-2.5-flash-image",
        "timeoutMs": 120000,
        "maxConcurrent": 2
      },
      "replicate": {
        "model": "black-forest-labs/flux-schnell",
        "timeoutMs": 120000,
        "maxConcurrent": 2
      },
      "fal": {
        "model": "fal-ai/flux/schnell",
        "timeoutMs": 120000,
        "maxConcurrent": 2
      },
      "together": {
        "model": "black-forest-labs/FLUX.2-dev",
        "timeoutMs": 120000,
        "maxConcurrent": 2
      },
      "drawthings": {
        "enabled": false,
        "host": "127.0.0.1",
        "port": 7860,
        "allowLan": false,
        "timeoutMs": 300000,
        "maxConcurrent": 1
      },
      "coreml": {
        "enabled": false,
        "modelsDir": "~/MochiDiffusion/models/",
        "computeUnits": "auto",
        "timeoutMs": 300000
      }
    }
  }
}
