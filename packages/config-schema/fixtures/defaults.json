{
  "$schema": "https://plur1bus.dev/schema/config/1/config.schema.json",
  "schemaVersion": 1,
  "core": {
    "logLevel": "info",
    "recall": {
      "softBudgetMs": 400,
      "hardBudgetMs": 600,
      "capChars": 17000
    },
    "capture": {
      "waitMs": 60000
    },
    "shutdownBudgetMs": 30000
  },
  "supervisor": {
    "graceMs": 60000,
    "healthIntervalMs": 5000
  },
  "metrics": {
    "enabled": false,
    "port": 9464
  },
  "logs": {
    "maxBytes": 20971520,
    "keep": 5
  },
  "agents": {},
  "extensions": {
    "allowUnsigned": true,
    "trashDays": 14,
    "limits": {
      "packageBytes": 268435456,
      "skillBytes": 16777216
    }
  },
  "embedding": {
    "useClass": "general",
    "acceptedNcLicence": false
  },
  "engine": {},
  "providers": {},
  "auth": {
    "openai": {
      "loopbackTimeoutMs": 600000,
      "httpTimeoutMs": 30000,
      "refreshSkewSeconds": 120,
      "liveHandleTtlSeconds": 60,
      "voiceDailySeconds": 3600,
      "voiceCapacity": 1,
      "clientRegistration": "dynamic_on_authorize",
      "storeBackend": "auto",
      "federated": {
        "args": [],
        "environment": {}
      }
    }
  },
  "oauth": {},
  "decision": {},
  "modelRoles": {},
  "modelProfiles": {},
  "models": {
    "scan": {
      "enabled": true,
      "intervalHours": 24
    }
  },
  "secrets": {
    "fileFallback": {
      "enabled": false
    }
  },
  "egress": {
    "allowHosts": [],
    "allowPorts": [
      443
    ],
    "allowLoopback": false
  },
  "modules": {}
}
