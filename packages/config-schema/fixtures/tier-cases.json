    "basic": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://plur1bus.dev/schema/config/1/config.schema.json",
      "title": "PLUR1BUS harness config.json (schemaVersion 1)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "object",
          "default": {},
          "x-restart": "live",
          "x-tier": "basic",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "displayName": {
                "type": "string",
                "maxLength": 128
              },
              "skills": {
                "description": "Per-agent skill selection (X1-R11): `blocked` names skills this agent does not get although they are enabled installation-wide; `pinned` is stored and shown, not interpreted before D69; `applyAt` says when a change reaches a running agent.",
                "type": "object",
                "additionalProperties": false,
                "x-restart": "live",
                "x-tier": "advanced",
                "properties": {
                  "blocked": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "pinned": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "applyAt": {
                    "enum": [
                      "next-turn",
                      "next-session"
                    ],
                    "default": "next-turn"
                  }
                }
              }
            }
          }
        },
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "useClass": {
              "enum": [
                "general",
                "research",
                "commercial"
              ],
              "default": "general",
              "x-restart": "core",
              "x-tier": "basic"
            }
          }
        },
        "providers": {
          "type": "object",
          "default": {},
          "x-restart": "live",
          "x-tier": "basic",
          "x-reserved": "M2 (D15)",
          "additionalProperties": true
        },
        "modelRoles": {
          "type": "object",
          "default": {},
          "x-restart": "live",
          "x-tier": "basic",
          "x-reserved": "M2 (D15, D18)",
          "propertyNames": {
            "enum": [
              "chat",
              "reasoning",
              "capture",
              "dream",
              "embedding",
              "rerank",
              "decision"
            ]
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": []
    },
    "advanced": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://plur1bus.dev/schema/config/1/config.schema.json",
      "title": "PLUR1BUS harness config.json (schemaVersion 1)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string",
          "x-restart": "live",
          "x-tier": "advanced"
        },
        "schemaVersion": {
          "const": 1,
          "x-restart": "core",
          "x-tier": "advanced"
        },
        "core": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "logLevel": {
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ],
              "default": "info",
              "x-restart": "live",
              "x-tier": "advanced"
            },
            "recall": {
              "type": "object",
              "additionalProperties": false,
              "default": {},
              "properties": {
                "softBudgetMs": {
                  "type": "integer",
                  "minimum": 50,
                  "default": 400,
                  "x-restart": "core",
                  "x-tier": "advanced"
                },
                "hardBudgetMs": {
                  "type": "integer",
                  "minimum": 100,
                  "default": 600,
                  "x-restart": "live",
                  "x-tier": "advanced"
                },
                "capChars": {
                  "type": "integer",
                  "minimum": 1000,
                  "default": 17000,
                  "x-restart": "core",
                  "x-tier": "advanced"
                }
              }
            },
            "capture": {
              "type": "object",
              "additionalProperties": false,
              "default": {},
              "properties": {
                "waitMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "default": 60000,
                  "x-restart": "live",
                  "x-tier": "advanced"
                }
              }
            },
            "shutdownBudgetMs": {
              "type": "integer",
              "minimum": 1000,
              "default": 30000,
              "x-restart": "live",
              "x-tier": "advanced"
            }
          }
        },
        "supervisor": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "graceMs": {
              "type": "integer",
              "minimum": 1000,
              "default": 60000,
              "x-restart": "live",
              "x-tier": "advanced"
            },
            "healthIntervalMs": {
              "type": "integer",
              "minimum": 1000,
              "default": 5000,
              "x-restart": "live",
              "x-tier": "advanced"
            }
          }
        },
        "metrics": {
          "description": "D3: the read-only Prometheus text endpoint `GET /metrics` on a loopback address, protected by a bearer token kept in `state/metrics.token`.",
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "x-restart": "core",
              "x-tier": "advanced"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "default": 9464,
              "x-restart": "core",
              "x-tier": "advanced"
            }
          }
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "maxBytes": {
              "type": "integer",
              "minimum": 1048576,
              "default": 20971520,
              "x-restart": "live",
              "x-tier": "advanced"
            },
            "keep": {
              "type": "integer",
              "minimum": 1,
              "default": 5,
              "x-restart": "live",
              "x-tier": "advanced"
            }
          }
        },
        "extensions": {
          "description": "Extension management (X1-R21): whether unsigned packages may be installed, how many days uninstalled items stay in the trash, and the size caps for packages and skill folders.",
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "allowUnsigned": {
              "type": "boolean",
              "default": true,
              "x-restart": "live",
              "x-tier": "advanced"
            },
            "trashDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 14,
              "x-restart": "live",
              "x-tier": "advanced"
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "default": {},
              "properties": {
                "packageBytes": {
                  "type": "integer",
                  "minimum": 1048576,
                  "maximum": 1073741824,
                  "default": 268435456,
                  "x-restart": "live",
                  "x-tier": "advanced"
                },
                "skillBytes": {
                  "type": "integer",
                  "minimum": 1048576,
                  "maximum": 1073741824,
                  "default": 16777216,
                  "x-restart": "live",
                  "x-tier": "advanced"
                }
              }
            }
          }
        },
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "acceptedNcLicence": {
              "type": "boolean",
              "default": false,
              "x-restart": "core",
              "x-tier": "advanced"
            },
            "acceptedNcLicenceAt": {
              "type": "string",
              "format": "date-time",
              "x-restart": "core",
              "x-tier": "advanced"
            }
          }
        },
        "engine": {
          "description": "Pass-through to the engine's EngineConfig (57 keys, see docs/config-engine-keys.md). Every key here is class core until the engine declares readAt: live (engine PR E5).",
          "type": "object",
          "default": {},
          "x-restart": "core",
          "x-tier": "advanced",
          "properties": {
            "baseDbPathOverride": {
              "type": "string",
              "x-restart": "core",
              "x-tier": "advanced",
              "description": "Testing/advanced only; default <home>/state/lancedb"
            }
          },
          "additionalProperties": true
        },
        "oauth": {
          "type": "object",
          "default": {},
          "x-restart": "live",
          "x-tier": "advanced",
          "x-reserved": "M2 (D16)",
          "additionalProperties": true
        },
        "decision": {
          "type": "object",
          "default": {},
          "x-restart": "live",
          "x-tier": "advanced",
          "x-reserved": "M2 (D18)",
          "additionalProperties": true
        },
        "modelProfiles": {
          "description": "Named model profiles (C4): an ordered candidate list with weights for fallback or mixture-of-agents (moa) use, plus sampling parameters and cache hints. Data only; selection is the router's job. List order is priority order.",
          "type": "object",
          "default": {},
          "x-restart": "live",
          "x-tier": "advanced",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidates"
            ],
            "properties": {
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "strategy": {
                "enum": [
                  "fallback",
                  "moa"
                ],
                "default": "fallback"
              },
              "candidates": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "model"
                  ],
                  "properties": {
                    "model": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "weight": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 100,
                      "default": 1
                    }
                  }
                }
              },
              "aggregator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "default": {},
                "properties": {
                  "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "topP": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "maxTokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2000000
                  }
                }
              },
              "cache": {
                "type": "object",
                "additionalProperties": false,
                "default": {},
                "properties": {
                  "hint": {
                    "enum": [
                      "auto",
                      "none",
                      "prefer"
                    ],
                    "default": "auto"
                  },
                  "ttlSeconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 86400
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "strategy"
                  ],
                  "properties": {
                    "strategy": {
                      "const": "moa"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "candidates": {
                      "type": "array",
                      "minItems": 2
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "aggregator"
                  ],
                  "properties": {
                    "aggregator": {}
                  }
                },
                "then": {
                  "required": [
                    "strategy"
                  ],
                  "properties": {
                    "strategy": {
                      "const": "moa"
                    }
                  }
                }
              }
            ]
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "scan": {
              "type": "object",
              "additionalProperties": false,
              "default": {},
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "x-restart": "live",
                  "x-tier": "advanced"
                },
                "intervalHours": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 168,
                  "default": 24,
                  "x-restart": "live",
                  "x-tier": "advanced"
                }
              }
            }
          }
        },
        "secrets": {
          "description": "Secret store (M2, ADR-005). The OS keyring is always tried first.",
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "fileFallback": {
              "type": "object",
              "additionalProperties": false,
              "default": {},
              "properties": {
                "enabled": {
                  "description": "Use the encrypted file store (AES-256-GCM, machine-bound key file next to it) when the OS keyring is unavailable. Off until the owner decides ADR-005 Q3.",
                  "type": "boolean",
                  "default": false,
                  "x-restart": "live",
                  "x-tier": "advanced"
                }
              }
            }
          }
        },
        "egress": {
          "description": "Outgoing network policy (B4). Default deny: nothing is reachable until a host is listed. https only (plain http only to a listed loopback host when allowLoopback is on); private, link-local and metadata addresses are refused after name resolution whatever is listed.",
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "allowHosts": {
              "description": "Exact names, `*.suffix` (subdomains of any depth, not the apex), `*` (any name, never an IP literal) or an exact canonical IP literal (IPv6 in brackets).",
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "default": [],
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "x-restart": "live",
              "x-tier": "advanced"
            },
            "allowPorts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "default": [
                443
              ],
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "x-restart": "live",
              "x-tier": "advanced"
            },
            "allowLoopback": {
              "description": "Allow http(s) to loopback hosts (localhost, 127.0.0.0/8, ::1) that are also listed in allowHosts. A public name that resolves to loopback stays refused.",
              "type": "boolean",
              "default": false,
              "x-restart": "live",
              "x-tier": "advanced"
            }
          }
        },
        "modules": {
          "description": "Per-module settings, keyed by module name (B13). A change restarts only that module; `enabled: false` keeps it stopped.",
          "type": "object",
          "default": {},
          "x-restart": "live",
          "x-tier": "advanced",
          "additionalProperties": {
            "type": "object",
            "x-restart": "module:$key",
            "x-tier": "advanced",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "required": [
        "schemaVersion"
      ]
    }
  }
}
