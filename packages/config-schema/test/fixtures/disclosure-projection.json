      "expectedDisplay": {
        "endpoint": "https://••••@host.example/public/path?token=••••&region=••••&api-version=••••#section=••••"
      },
      "expectedBackup": {
        "endpoint": "https://REDACTED@host.example/public/path?token=REDACTED&region=REDACTED&api-version=REDACTED#section=REDACTED"
      },
      "registered": [
        "$CANARY"
      ],
      "notRegistered": [
        "public-user",
        "host.example",
        "/public/path",
        "us-east-1",
        "2024-02-01",
        "public-heading"
      ]
    },
