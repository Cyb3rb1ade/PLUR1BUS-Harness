        },
        "oauth": {
          "opaque": {
            "clientSecret": "$CANARY"
          }
        },
        "engine": {
          "someUnknownKey": "$CANARY",
          "schicht15": {
            "undeclared": "$CANARY"
          }
        },
        "modules": {
          "absent": {
            "token": "$CANARY",
            "nested": {
              "password": "$CANARY"
            }
          }
        },
        "voice": {
          "local": {
            "catalogOverride": {
              "entry": {
                "opaque": "$CANARY"
              }
            }
          }
        },
        "unknown": {
          "password": "$CANARY",
          "count": 7,
          "enabled": true
        }
      },
      "expectedDisplay": {
        "providers": {
          "unlisted": {
            "apiKey": "••••"
          }
        },
        "oauth": {
          "opaque": {
            "clientSecret": "••••"
          }
        },
        "engine": {
          "someUnknownKey": "••••",
          "schicht15": {
            "undeclared": "••••"
          }
        },
        "modules": {
          "absent": {
            "token": "••••",
            "nested": {
              "password": "••••"
            }
          }
        },
        "voice": {
          "local": {
            "catalogOverride": {
              "entry": {
                "opaque": "••••"
              }
            }
          }
        },
        "unknown": {
          "password": "••••",
          "count": 7,
          "enabled": true
        }
      },
      "expectedBackup": {
        "providers": {
          "unlisted": {
            "apiKey": "$ARCHIVE_MASK"
          }
        },
        "oauth": {
          "opaque": {
            "clientSecret": "$ARCHIVE_MASK"
