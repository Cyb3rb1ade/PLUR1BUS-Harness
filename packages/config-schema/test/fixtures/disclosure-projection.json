            "x-sensitive": true,
            "x-secret-reference": true
          },
          "literal": {
            "type": "string",
            "x-sensitive": true
          }
        }
      },
      "value": {
        "ref": "curated-key",
        "literal": "$CANARY"
      },
      "expectedDisplay": {
        "ref": "curated-key",
        "literal": "••••"
      },
      "expectedBackup": {
        "ref": "curated-key",
        "literal": "$ARCHIVE_MASK"
      },
      "registered": [
        "$CANARY"
      ],
      "notRegistered": [
        "curated-key"
      ]
    },
    {
      "name": "URL components and selective text registration",
