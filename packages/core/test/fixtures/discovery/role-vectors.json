[
  {
    "name": "provider prefix with colon in provider id",
    "catalog": [
      { "provider": "openai:chatgpt-plan", "id": "example-chat-large", "aliases": [], "status": "available" }
    ],
    "value": "openai:chatgpt-plan/example-chat-large",
    "expect": { "provider": "openai:chatgpt-plan", "id": "example-chat-large", "state": "available" }
  },
  {
    "name": "model id containing slash",
    "catalog": [
      { "provider": "openrouter", "id": "vendor/model", "aliases": [], "status": "available" }
    ],
    "value": "openrouter/vendor/model",
    "expect": { "provider": "openrouter", "id": "vendor/model", "state": "available" }
  },
  {
    "name": "longest provider prefix wins",
    "catalog": [
      { "provider": "or", "id": "x/y", "aliases": [], "status": "unavailable" },
      { "provider": "or/x", "id": "y", "aliases": [], "status": "available" }
    ],
    "value": "or/x/y",
    "expect": { "provider": "or/x", "id": "y", "state": "available" }
  },
  {
    "name": "bare model id",
    "catalog": [
      { "provider": "anthropic", "id": "example-claude-3-5-sonnet", "aliases": [], "status": "available" }
    ],
    "value": "example-claude-3-5-sonnet",
    "expect": { "provider": "anthropic", "id": "example-claude-3-5-sonnet", "state": "available" }
  },
  {
    "name": "alias resolution under provider prefix",
    "catalog": [
      { "provider": "openai", "id": "example-chat-large-20260101", "aliases": ["example-chat"], "status": "available" }
    ],
    "value": "openai/example-chat",
    "expect": { "provider": "openai", "id": "example-chat-large-20260101", "state": "available" }
  },
  {
    "name": "bare alias resolution",
    "catalog": [
      { "provider": "openai", "id": "example-chat-large-20260101", "aliases": ["example-chat"], "status": "available" }
    ],
    "value": "example-chat",
    "expect": { "provider": "openai", "id": "example-chat-large-20260101", "state": "available" }
  },
  {
    "name": "bare id on two providers with one available",
    "catalog": [
      { "provider": "p1", "id": "shared-model", "aliases": [], "status": "unavailable" },
      { "provider": "p2", "id": "shared-model", "aliases": [], "status": "available" }
    ],
    "value": "shared-model",
    "expect": { "provider": "p2", "id": "shared-model", "state": "available" }
  },
  {
    "name": "unknown model value",
    "catalog": [
      { "provider": "p1", "id": "m1", "aliases": [], "status": "available" }
    ],
    "value": "non-existent-model",
    "expect": null
  },
  {
    "name": "unavailable model resolved",
    "catalog": [
      { "provider": "p1", "id": "m-dead", "aliases": [], "status": "unavailable" }
    ],
    "value": "p1/m-dead",
    "expect": { "provider": "p1", "id": "m-dead", "state": "unavailable" }
  }
]
