{
  "name": "@plur1bus/embedding-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.16.0 <25 || >=26.1.0" },
  "exports": { ".": { "source": "./src/index.ts", "types": "./src/index.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/index.js",
    "test": "node ../../scripts/test-package.mjs",
    "test:coverage": "node --experimental-strip-types --conditions=source --no-warnings=ExperimentalWarning --test --test-concurrency=1 --experimental-test-coverage \"--test-coverage-include=src/**/*.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
