{
  "name": "@plur1bus/log-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.16.0 <25 || >=26.1.0" },
  "exports": { ".": { "source": "./src/index.ts", "types": "./src/index.ts", "default": "./dist/index.js" }, "./schema/record": "./schema/record.schema.json", "./schema/catalogue": "./schema/catalogue.json", "./schema/levels": "./schema/levels.json", "./schema/redaction": "./schema/redaction.json" },
  "files": ["dist", "schema", "fixtures"],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/index.js",
    "gen": "node --experimental-strip-types src/gen-fixtures.mjs",
    "test": "node --experimental-strip-types src/gen-fixtures.mjs && node ../../scripts/test-package.mjs"
  },
  "dependencies": { "ajv": "8.20.0", "ajv-formats": "^3.0.1" }
}
