{
  "name": "@plur1bus/voice-providers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/local/catalog.json"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/index.js",
    "test": "node ../../scripts/test-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@aws-sdk/client-polly": "^3.0.0",
    "@aws-sdk/credential-providers": "^3.0.0",
    "sherpa-onnx-node": "^1.13.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-polly": {
      "optional": true
    },
    "@aws-sdk/credential-providers": {
      "optional": true
    },
    "sherpa-onnx-node": {
      "optional": true
    }
  }
}
