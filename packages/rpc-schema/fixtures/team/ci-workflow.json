{
  "source": ".github/workflows/ci.yml",
  "sha256": "260d4a90ec60f531d0d0fde28ffe8116ece7019198243bc9161f382d56f45ccb",
  "projection": "Job bodies omitted; trigger and root metadata retained from parsed source.",
  "workflow": {
    "name": "ci",
    "on": {
      "push": {
        "branches": [
          "main"
        ]
      },
      "pull_request": {
        "types": [
          "opened",
          "synchronize",
          "reopened",
          "labeled"
        ]
      },
      "merge_group": {
        "types": [
          "checks_requested"
        ]
      },
      "schedule": [
        {
          "cron": "29 3 * * *"
        }
      ],
      "workflow_dispatch": ""
    },
    "concurrency": {
      "group": "${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}${{ github.event.action == 'labeled' && github.event.label.name != 'ci:macos' && '-noop' || '' }}",
      "cancel-in-progress": "${{ github.event_name == 'pull_request' }}"
    },
    "permissions": {
      "contents": "read"
    },
    "jobs": {}
  }
}
