{
  "source": ".github/workflows/ci.yml",
  "sha256": "928b58be3b000b46cedb662502033685b11c322b96050bff9b3e4f24c018c067",
  "projection": "Job bodies omitted; trigger and root metadata retained from parsed source.",
  "workflow": {
    "name": "ci",
    "on": {
      "push": {
        "branches": [
          "main"
        ]
      },
      "pull_request": {
        "types": [
          "opened",
          "synchronize",
          "reopened",
          "labeled"
        ]
      },
      "merge_group": {
        "types": [
          "checks_requested"
        ]
      },
      "schedule": [
        {
          "cron": "29 3 * * *"
        }
      ],
      "workflow_dispatch": ""
    },
    "concurrency": {
      "group": "${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}${{ github.event.action == 'labeled' && github.event.label.name != 'ci:macos' && '-noop' || '' }}",
      "cancel-in-progress": "${{ github.event_name == 'pull_request' }}"
    },
    "permissions": {
      "contents": "read"
    },
    "jobs": {}
  }
}
