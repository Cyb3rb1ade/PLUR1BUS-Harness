{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-approved dependency licence exceptions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exceptions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ecosystem",
          "name",
          "license",
          "reason",
          "expires"
        ],
        "properties": {
          "ecosystem": {
            "enum": [
              "pnpm",
              "cargo",
              "cargo-desktop",
              "python"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expires": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
