{
  "exporter": "scripts/parity/export-channels.ts",
  "scenarios": [
    {
      "exchanges": [
        {
          "request": {
            "bodyText": "{\"timeout\":25,\"allowed_updates\":[\"message\",\"callback_query\"]}",
            "headers": {
              "content-type": "application/json"
            },
            "method": "POST",
            "path": "/v1/bot[FIXTURE:TELEGRAM]/getUpdates"
          },
          "response": {
            "body": {
              "ok": true,
              "result": [
                {
                  "update_id": 8
                }
              ]
            },
            "status": 200
          }
        }
      ],
      "expected": {
        "result": [
          {
            "update_id": 8
          }
        ]
      },
      "input": {
        "op": "updates",
        "wait": 25
      },
      "name": "updates-initial"
    },
    {
      "exchanges": [
        {
          "request": {
            "bodyText": "{\"timeout\":3,\"allowed_updates\":[\"message\",\"callback_query\"],\"offset\":9}",
            "headers": {
              "content-type": "application/json"
            },
            "method": "POST",
            "path": "/v1/bot[FIXTURE:TELEGRAM]/getUpdates"
          },
          "response": {
            "body": {
              "ok": true,
              "result": []
            },
            "status": 200
          }
        }
      ],
      "expected": {
        "result": []
      },
      "input": {
        "offset": 9,
        "op": "updates",
        "wait": 3
      },
      "name": "updates-resume"
    },
    {
      "exchanges": [
        {
          "request": {
            "bodyText": "{\"parse_mode\":\"HTML\",\"message_thread_id\":7,\"chat_id\":\"-1234\",\"text\":\"Grüße 👋\"}",
            "headers": {
              "content-type": "application/json"
            },
            "method": "POST",
            "path": "/v1/bot[FIXTURE:TELEGRAM]/sendMessage"
          },
          "response": {
            "body": {
              "ok": true,
              "result": {
                "message_id": 30
              }
            },
            "status": 200
          }
        }
      ],
      "expected": {
        "result": 30
      },
      "input": {
        "chat": "-1234",
        "extra": "{\"parse_mode\":\"HTML\",\"message_thread_id\":7}",
        "op": "send",
        "text": "Grüße 👋"
      },
      "name": "send-message"
    },
    {
      "exchanges": [
        {
          "request": {
            "bodyText": "{\"chat_id\":\"42\",\"text\":\"hello\"}",
            "headers": {
              "content-type": "application/json"
            },
            "method": "POST",
            "path": "/v1/bot[FIXTURE:TELEGRAM]/sendMessage"
          },
          "response": {
            "body": {
              "ok": true,
              "result": {}
            },
            "status": 200
          }
        }
      ],
      "expected": {
        "error": {
          "kind": "protocol",
          "message": "sendMessage result lacks message_id"
        }
      },
      "input": {
        "chat": "42",
        "op": "send",
        "text": "hello"
      },
      "name": "send-no-id"
    },
    {
      "exchanges": [
        {
          "request": {
