        {
          "text": "voice 🎙 "
        },
        {
          "flush": true,
          "text": " "
        },
        {
          "text": ""
        }
      ]
    }
  ],
  "expected": {
    "chunks": [
      {
        "dataBase64": "AQIA",
        "format": "pcm16",
        "sampleRate": 24000
      },
      {
        "dataBase64": "/wA=",
        "format": "pcm16",
        "sampleRate": 24000
      }
    ],
    "usage": {
