# Files shipped in the Hermes provider tarball and the client wheel/sdist are built byte for byte from the
# checkout (scripts/build-hermes-provider.mjs refuses CR); a Windows autocrlf checkout must not change them.
hosts/hermes/plur1bus/** text eol=lf
clients/python/**/src/** text eol=lf
LICENSE text eol=lf
docs/ops/zabbix/** text eol=lf
# Generated config-schema fixtures are checked byte for byte by `gen-defaults.mjs --check` (CI unit job, all OSes);
# a Windows autocrlf checkout must not turn them into CRLF.
packages/config-schema/fixtures/*.json text eol=lf
