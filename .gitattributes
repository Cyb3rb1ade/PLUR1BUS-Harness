# Files shipped in the Hermes provider tarball and the client wheel/sdist are built byte for byte from the
# checkout (scripts/build-hermes-provider.mjs refuses CR); a Windows autocrlf checkout must not change them.
hosts/hermes/plur1bus/** text eol=lf
clients/python/**/src/** text eol=lf
LICENSE text eol=lf
docs/ops/zabbix/** text eol=lf
# Generated config-schema fixtures are checked byte for byte by `gen-defaults.mjs --check` (CI unit job, all OSes);
# a Windows autocrlf checkout must not turn them into CRLF.
packages/config-schema/fixtures/*.json text eol=lf
# The web.fetch golden corpus is byte-exact: legacy-charset pages and exact-text goldens must not gain CRLF on a Windows checkout.
packages/core/test/fixtures/web-fetch/** -text
# The Laya spike sources and fixtures are hashed byte for byte by scripts/test/decision-laya.acceptance.todo.test.mjs
# and recorded in docs/evidence/decision/*.json; a Windows autocrlf checkout must not change them.
scripts/spikes/** text eol=lf
# Node engine parity recordings are byte-exact goldens across checkout platforms.
crates/plur1bus-engine/tests/fixtures/**/*.json -text
# The BGE licence receipt checks the Apache-2.0 text byte for byte (model-recording.mjs assertBgeLicence).
crates/plur1bus-engine/tests/fixtures/vectors/licences/** -text
# Recorded JS text vectors and lone-surrogate JSONL fixtures are asserted byte for byte (RE-04/T0, RE-D17).
crates/plur1bus-engine/tests/fixtures/text/** -text
# RE-02 store files and neutral schema dumps retain the bytes written by the pinned Node engine.
crates/plur1bus-engine/tests/fixtures/store-v1/** -text
crates/plur1bus-engine/tests/fixtures/store-surrogate/** -text
crates/plur1bus-engine/tests/fixtures/sqlite/** -text
crates/plur1bus-engine/tests/fixtures/neo-v1/** -text
