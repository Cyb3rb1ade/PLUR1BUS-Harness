# Run from an extracted Linux archive; render separately for amd64 and arm64.
name: plur1bus
arch: @ARCH@
platform: linux
version: @VERSION@
maintainer: Cyb3rb1ade <84099452+Cyb3rb1ade@users.noreply.github.com>
description: PLUR1BUS CLI and memory harness
homepage: https://github.com/Cyb3rb1ade/PLUR1BUS-Harness
license: MIT
contents:
  - src: bin/plur1bus
    dst: /usr/bin/plur1bus
    file_info:
      mode: 0755
      owner: root
      group: root
  - src: bin/plur1bus-attest
    dst: /usr/bin/plur1bus-attest
    file_info:
      mode: 0755
      owner: root
      group: root
  - src: share/polkit-1/actions/org.plur1bus.approve.policy
    dst: /usr/share/polkit-1/actions/org.plur1bus.approve.policy
    file_info:
      mode: 0644
      owner: root
      group: root
  - src: licenses/LICENSE
    dst: /usr/share/licenses/plur1bus/LICENSE
    file_info:
      mode: 0644
      owner: root
      group: root
  - src: runtime/core.tar.gz
    dst: /usr/share/plur1bus/core.tar.gz
    file_info:
      mode: 0644
      owner: root
      group: root
  - src: README.txt
    dst: /usr/share/doc/plur1bus/README.txt
    file_info:
      mode: 0644
      owner: root
      group: root
  - src: completions/plur1bus.bash
    dst: /usr/share/bash-completion/completions/plur1bus
    file_info:
      mode: 0644
      owner: root
      group: root
  - src: completions/_plur1bus
    dst: /usr/share/zsh/vendor-completions/_plur1bus
    file_info:
      mode: 0644
      owner: root
      group: root
  - src: completions/plur1bus.fish
    dst: /usr/share/fish/vendor_completions.d/plur1bus.fish
    file_info:
      mode: 0644
      owner: root
      group: root
  - src: man/man1/*.1
    dst: /usr/share/man/man1/
    file_info:
      mode: 0644
      owner: root
      group: root
