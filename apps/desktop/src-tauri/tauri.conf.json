{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLUR1BUS",
  "version": "0.1.0",
  "identifier": "app.plur1bus.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @plur1bus/desktop-ui build",
    "beforeBuildCommand": "pnpm --filter @plur1bus/desktop-ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "shell",
        "title": "PLUR1BUS",
        "url": "index.html",
        "visible": false,
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "freezePrototype": true,
      "capabilities": [
        "shell-ui",
        "approvals"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/plur1bus-host"
    ]
  }
}
